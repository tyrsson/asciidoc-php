{
    "name": "webware/asciidoc-php",
    "description": "A template repository for new PHP projects",
    "license": "BSD-3-Clause",
    "keywords": [
        "template",
        "repository",
        "php"
    ],
    "authors": [
        {
            "name": "Joey (aka Tyrsson) Smith",
            "email": "jsmith@webinertia.net",
            "homepage": "https://github.com/tyrsson/asciidoc-php/discussions",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.6.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "bin": [
        "bin/asciidoc-php"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.0.0",
        "roave/security-advisories": "dev-master",
        "webware/coding-standard": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Webware\\AsciidocPhp\\": "src/"
        }
    },
    "extra": {
        "resources-dir": "resources"
    },
    "autoload-dev": {
        "psr-4": {
            "Webware\\AsciidocPhp\\IntegrationTest\\": "test/integration/",
            "Webware\\AsciidocPhp\\TestAsset\\": "test/asset/",
            "Webware\\AsciidocPhp\\Test\\": "test/unit/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@sa",
            "@test",
            "@test-integration"
        ],
        "cs-check": "vendor/bin/php-cs-fixer check -v --show-progress=dots --stop-on-violation",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "sa": "vendor/bin/phpstan analyse --memory-limit=256M",
        "sa-gen-baseline": "vendor/bin/phpstan analyse --memory-limit=256M --generate-baseline",
        "sa-verbose": "vendor/bin/phpstan analyse --memory-limit=256M -vv",
        "upload-coverage": "coveralls -v",
        "render": "php bin/asciidoc-php -o test/results/full-document.html test/asset/integration/full-document.adoc",
        "render-embedded": "php bin/asciidoc-php -s -o test/results/full-document-embedded.html test/asset/integration/full-document.adoc",
        "render-preview": "php bin/render-preview test/asset/integration/full-document.adoc test/results/full-document-preview.html"
    }
}
